# Browser (required on Vercel — set in Project → Settings → Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only API routes (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional
RESEND_API_KEY=
RESEND_FROM=Credit Path Canada <onboarding@resend.dev>
AUTO_READY_ALERT_WEBHOOK_URL=
VA_PORTAL_PASSWORD=
# Bearer secret for GET/POST /api/email-drip (Vercel Cron or manual daily trigger)
CRON_SECRET=
# Optional: dedicated HMAC secret for one-click unsubscribe links (falls back to EMAIL_TRIGGER_SECRET)
UNSUBSCRIBE_SECRET=

# Stripe (subscriptions) — set NEXT_PUBLIC_SITE_URL in production for correct checkout redirect URLs
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=price_1TPnfhHFU4IuRuZYxeNJbLZJ
STRIPE_WEBHOOK_SECRET=
